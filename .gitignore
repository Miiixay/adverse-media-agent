# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# working files, not part of the deliverable
/CLAUDE.md
/PLAN.md
/PROMPTS-CLAUDE-CODE.md
/AGENTS.md

# run logs (may contain personal data)
/logs

# the example env file is the documentation of the required variables
!.env.example
review.zip
gitlog.txt
